#!/usr/bin/env bash
# prime: download vanilla Purpur once and let paperclip fetch and patch what it
# needs (cache/, libraries/, versions/), so dev tests boot it offline.
# Prints the primed directory. The only step of the dev tier that needs network.
set -euo pipefail

version=26.1.2 build=2592 md5=0d01a9bcabd5e32b1e5e5d48901f1f17
sha256=d88e3826a7f3ad3cb4b07be02fc732ba732bf1a1b113d96b605e9f8d1d119608
image=eclipse-temurin:25-jre@sha256:ecdc0adb37bde1a281c4d245a3cd535004b1fc8322d560f5b09463b248c81df0
dir=${XDG_CACHE_HOME:-$HOME/.cache}/mc-harness/purpur-$version-$build

if [[ ! -f $dir/.primed ]]; then
  mkdir -p "$dir"
  curl -fsSL -o "$dir/purpur.jar.part" "https://api.purpurmc.org/v2/purpur/$version/$build/download"
  [[ $(md5sum <"$dir/purpur.jar.part") == "$md5  -" && $(sha256sum <"$dir/purpur.jar.part") == "$sha256  -" ]] ||
    { echo "prime: checksum mismatch for purpur $version-$build" >&2; exit 2; }
  mv "$dir/purpur.jar.part" "$dir/purpur.jar"
  docker run --rm --user "$(id -u):$(id -g)" -v "$dir:/server" -w /server "$image" \
    java -Dpaperclip.patchonly=true -jar purpur.jar >&2
  touch "$dir/.primed"
fi
echo "$dir"
