#!/usr/bin/env bash
# Run inside a pod container: prints one line per isolation check and exits
# non-zero if any way out exists. Used by test/dev/dev.bats.
set -u
bad=0
# Destination 00000000 is a default route.
if awk 'NR > 1 && $2 == "00000000" { found = 1 } END { exit !found }' /proc/net/route; then echo 'ipv4 default route'; bad=1; else echo 'no ipv4 default route'; fi
if [[ -r /proc/net/ipv6_route ]] && awk '$1 == "00000000000000000000000000000000" && $2 == "00" && $10 != "lo" { found = 1 } END { exit !found }' /proc/net/ipv6_route; then echo 'ipv6 default route'; bad=1; else echo 'no ipv6 default route'; fi
if timeout 5 bash -c '</dev/tcp/1.1.1.1/443' 2>/dev/null; then echo 'tcp 1.1.1.1:443 reachable'; bad=1; else echo 'tcp 1.1.1.1:443 unreachable'; fi
if timeout 10 getent hosts example.com >/dev/null; then echo 'example.com resolves'; bad=1; else echo 'example.com does not resolve'; fi
# 8192 is 2000 in hex; state 0A is LISTEN.
if cat /proc/net/tcp /proc/net/tcp6 2>/dev/null | awk '$2 ~ /:2000$/ && $4 == "0A" { found = 1 } END { exit !found }'; then echo 'listening on 8192'; bad=1; else echo 'nothing on 8192'; fi
exit "$bad"
