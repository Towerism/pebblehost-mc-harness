# Copy to .env. Values come from panel.pebblehost.com → your server → Files → SFTP Credentials.
# Comments must be on their own lines; everything after = is the value.

# Host only, without :2022
PEBBLE_SFTP_HOST=
PEBBLE_SFTP_PORT=2022
# Looks like name.abcd1234
PEBBLE_SFTP_USER=
# The SFTP password is the game panel password
PEBBLE_PANEL_PASSWORD=
PEBBLE_SERVER_NAME=
# PEBBLE_PANEL_EMAIL is accepted and ignored.
